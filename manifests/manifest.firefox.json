{
  "browser_specific_settings": {
    "gecko": {
      "id": "qr-studio@local.addon",
      "strict_min_version": "128.0"
    }
  },
  "sidebar_action": {
    "default_title": "QR Studio",
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "open_at_install": false
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "clipboardWrite"
  ]
}