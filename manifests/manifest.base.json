{
  "manifest_version": 3,
  "name": "QR Studio — QR generator & scanner",
  "version": "1.0.0",
  "description": "Stylish QR code generator and scanner: custom dots, corners, logo, backgrounds, frames. Popup, side panel and full page.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "QR Studio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  }
}