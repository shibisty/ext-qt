{
  "name": "qr-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QR code generator & scanner browser extension (Chrome + Firefox from one source)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:chrome": "vite build --mode chrome --watch",
    "dev:firefox": "vite build --mode firefox --watch",
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "build": "npm run typecheck && npm run build:chrome && npm run build:firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
